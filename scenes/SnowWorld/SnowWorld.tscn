resource_name = "play random looping audio"
script/source = "@tool
extends AudioStreamPlayer

func _ready() -> void:
	finished.connect(_change_audio)

func _change_audio() -> void:
	# assuming its a AudioStreamRandomizer
	stop()
	play()
"

