[sub_resource type="Shader" id="Shader_80ooy"]
code = "shader_type canvas_item;
render_mode blend_mix;

uniform sampler2D gradient;
uniform float scrollSpeedX;
uniform float scaleX = 1;

void fragment() {
    vec2 uv = UV;
    uv.x += -scrollSpeedX * TIME;
	uv.x *= scaleX;
    uv.x = fract(uv.x); // This will make the texture repeat
    vec4 gradientColour = texture(gradient, uv);
	
    COLOR *= gradientColour;
}
"

